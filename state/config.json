{
  "schema_version": 1,
  "mode": "test",
  "paused": false,
  "schedule_enabled": false,
  "commit_target": "work_branch",
  "work_branch": "agent/work",
  "open_pull_request": true,
  "max_total_runs": 30,
  "max_consecutive_failures": 3,
  "inbox_issue_label": "agent-inbox",
  "model": "",
  "protected_paths": [
    ".github/",
    "agent/",
    "CLAUDE.md",
    "mission.md",
    "state/config.json",
    "state/runs.jsonl"
  ],
  "profiles": {
    "test": {
      "max_turns": 25,
      "allowed_tools": [
        "Read", "Write", "Edit", "MultiEdit", "Glob", "Grep", "LS", "TodoWrite",
        "WebSearch", "WebFetch",
        "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
        "Bash(mkdir:*)", "Bash(find:*)",
        "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
        "Bash(node:*)", "Bash(npm test:*)", "Bash(npm run test:*)",
        "Bash(python3:*)"
      ],
      "disallowed_tools": [
        "Bash(git push:*)", "Bash(git commit:*)", "Bash(git reset:*)", "Bash(git checkout:*)",
        "Bash(curl:*)", "Bash(wget:*)", "Bash(sudo:*)", "Bash(rm -rf:*)",
        "Bash(npm install:*)", "Bash(npm i:*)", "Bash(pip install:*)", "Bash(pip3 install:*)"
      ]
    },
    "live": {
      "max_turns": 60,
      "allowed_tools": [
        "Read", "Write", "Edit", "MultiEdit", "Glob", "Grep", "LS", "TodoWrite",
        "WebSearch", "WebFetch",
        "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
        "Bash(mkdir:*)", "Bash(find:*)", "Bash(rm:*)", "Bash(mv:*)", "Bash(cp:*)",
        "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
        "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)",
        "Bash(python3:*)", "Bash(pip install:*)"
      ],
      "disallowed_tools": [
        "Bash(git push:*)", "Bash(git commit:*)", "Bash(git reset:*)", "Bash(git checkout:*)",
        "Bash(curl:*)", "Bash(wget:*)", "Bash(sudo:*)", "Bash(rm -rf /*)"
      ]
    }
  }
}
